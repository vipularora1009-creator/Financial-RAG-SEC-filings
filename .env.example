# Copy to .env and fill in. Never commit .env.
POSTGRES_USER=rag
POSTGRES_DB=ingestion_ledger
POSTGRES_PASSWORD=set-me
# SEC asks every EDGAR client to identify itself: "Name email"
SEC_USER_AGENT=Your Name you@example.com
# Google AI Studio key for gemini-3.8-flash (router, HyDE, answers)
GEMINI_API_KEY=set-me
# Optional: Modal GPU for indexing (modal.com -> Settings -> API tokens)
MODAL_TOKEN_ID=set-me
MODAL_TOKEN_SECRET=set-me
